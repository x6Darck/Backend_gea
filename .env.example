# ============================================================================
# GEA BACKEND — Plantilla de variables de entorno
#
# Copia este archivo a ".env" (mismo directorio) y reemplaza cada valor por
# el real del servidor. NUNCA subas el archivo ".env" a git (ya está
# excluido en .gitignore) — solo esta plantilla ".env.example" se versiona.
#
#   cp .env.example .env
#

# ============================================================================

# ----------------------------------------------------------------------------
# BASE DE DATOS (MySQL)
# ----------------------------------------------------------------------------
# Contraseña del usuario root de MySQL. Genera una nueva, fuerte y única
# para el servidor — NUNCA reutilices la de desarrollo (1234).
DB_ROOT_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_FUERTE
DB_NAME=gea
DB_USERNAME=root

# ----------------------------------------------------------------------------
# SEGURIDAD (JWT y CORS)
# ----------------------------------------------------------------------------
# Secreto para firmar tokens JWT. Mínimo 32 caracteres, aleatorio y único
# por entorno. Generar con, por ejemplo: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Dominios reales autorizados a llamar a la API (separados por coma, sin
# espacios). Debe coincidir con el dominio público del frontend.
CORS_ALLOWED_ORIGINS=https://gea.tudominio.edu.co

# URL pública del frontend, usada en los enlaces que envían los correos de
# notificación (ej. "ver evento").
FRONTEND_URL=https://gea.tudominio.edu.co

# true en producción (requiere HTTPS real, ver certificados abajo). Nunca
# poner en true si el sitio se sirve por HTTP plano — el navegador
# descartará la cookie de sesión.
COOKIE_SECURE=true

# El backend está detrás de Nginx en este stack — Nginx es el único que puede escribir la IP real del
# cliente en X-Forwarded-For, por eso el rate-limiter confía en ese header.
# Dejar en true en este despliegue; solo poner en false si el backend
# alguna vez se expone SIN un proxy reverso delante.
RATE_LIMIT_TRUST_PROXY=true

# ----------------------------------------------------------------------------
# MICROSOFT OAUTH — login institucional de la app móvil
# ----------------------------------------------------------------------------
# Valores del registro de la app "GeaApp" en Azure (Azure Portal >
# Microsoft Entra ID > App registrations). El TENANT_ID y CLIENT_ID no son
# secretos; el CLIENT_SECRET SÍ lo es
#
# Si dejas estas variables vacías, el backend arranca igual pero el login
# con Microsoft queda deshabilitado (útil si el servidor de pruebas aún no
# tiene el registro de Azure configurado).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Generar/rotar en: App registration > Certificates & secrets > Client secrets.
# Pega aquí el "Value" (no el "Secret ID"). SOLO en el .env real, nunca en git.
MICROSOFT_CLIENT_SECRET=CAMBIAR_POR_EL_SECRET_REAL_SOLO_EN_EL_ENV_DEL_SERVIDOR
# Debe coincidir EXACTAMENTE con un Redirect URI registrado en Azure bajo la
# plataforma correspondiente.
MICROSOFT_REDIRECT_URI=https://com.gea.app/oauth2redirect

# ----------------------------------------------------------------------------
# CORREO (SMTP) — envío de notificaciones
# ----------------------------------------------------------------------------
SMTP_USER=gea.notificaciones@unilibrecucuta.edu.co
# Contraseña de aplicación de Gmail/Workspace (NO la contraseña normal de
# la cuenta). Se genera en: Cuenta de Google > Seguridad > Verificación en
# dos pasos > Contraseñas de aplicaciones.
SMTP_PASS=CAMBIAR_POR_LA_CONTRASENA_DE_APLICACION_REAL

# Correo(s) que reciben las notificaciones institucionales generales
# (separados por coma). Vacío = deshabilitado.
UNIVERSITY_RECIPIENTS=

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
# Ruta donde está clonado el
# repositorio GEA_FRONT. Por defecto asume que ambos repos están como
# carpetas hermanas con estos nombres exactos:
#   padre/
#   ├── GEA_BACKEND/      <- este repo
#   └── GEA_FRONT/
# Si clonas los repos con otra estructura de carpetas, ajusta esta
# ruta (puede ser relativa o absoluta).
FRONTEND_REPO_PATH=../GEA_FRONT

# ----------------------------------------------------------------------------
# RENDIMIENTO — ajustar solo cuando IT confirme la RAM real de la VM
# 
# ----------------------------------------------------------------------------
# Línea base calibrada para 8GB de RAM total en la VM (repartidos entre
# SO, Nginx, MySQL y esta JVM). Si la VM tiene 16GB, subir a "-Xmx6g" y
# BACKEND_MEM_LIMIT=7g; si tiene 32GB, "-Xmx10g" y BACKEND_MEM_LIMIT=11g.
JAVA_OPTS=-Xms1g -Xmx2560m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError
BACKEND_MEM_LIMIT=3g
