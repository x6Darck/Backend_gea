[mysqld]
# Tuning para VM compartida con el backend (línea base 8GB total: SO ~1GB, Nginx
# ~0.25GB, resto repartido mitad MySQL/mitad JVM -> ~2.5GB para MySQL, ~2.5GB de
# heap para la JVM). Ajustar innodb_buffer_pool_size según la tabla de tuning por
# RAM del plan de migración si la VM tiene más RAM (16GB -> 6G, 32GB -> 12G).
innodb_buffer_pool_size = 2560M
innodb_log_file_size    = 512M
# Durabilidad completa (fsync en cada commit). Bajar a 2 solo si se acepta perder
# hasta ~1s de transacciones ante un crash del sistema operativo, a cambio de mejor
# throughput de escritura.
innodb_flush_log_at_trx_commit = 1
# Coherente con el pool Hikari de la app (25 por defecto en application.properties);
# deja margen para herramientas de administración (mysql shell, backups, monitoring).
max_connections = 100
innodb_flush_method = O_DIRECT

# Slow query log: insumo para confirmar en producción qué queries realmente son
# lentas y decidir si faltan índices adicionales a los de la migración V8. Se guarda
# en el mismo volumen de datos (db_data) porque ya tiene los permisos correctos para
# el usuario mysql del contenedor; un directorio nuevo (ej. /var/log/mysql) requeriría
# verificar permisos en un entorno real, que no estaba disponible al escribir esto.
slow_query_log     = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time     = 0.5
