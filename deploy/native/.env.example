# ============================================================================
# GEA BACKEND — variables de entorno para despliegue NATIVO (sin Docker)
#
# Este archivo lo lee systemd directamente (EnvironmentFile=), NO Spring Boot.
# Instalación:
#   sudo mkdir -p /etc/gea
#   sudo cp deploy/native/backend.env.example /etc/gea/backend.env
#   sudo nano /etc/gea/backend.env   # completar cada valor real
#   sudo chmod 600 /etc/gea/backend.env
#   sudo chown gea:gea /etc/gea/backend.env
#
# Mismo formato KEY=VALOR que el .env.example de la raíz del repo (versión
# Docker) — la diferencia es que aquí no hay variables específicas de
# contenedores (FRONTEND_REPO_PATH, BACKEND_MEM_LIMIT, etc.). El límite de
# memoria en modo nativo se ajusta en gea-backend.service (MemoryMax).
# ============================================================================

# ----------------------------------------------------------------------------
# BASE DE DATOS (MySQL nativo, escuchando en localhost)
# ----------------------------------------------------------------------------
# Usar un usuario dedicado de la aplicación, NO root — ver el paso de creación
# de base de datos y usuario en deploy/native/README.md.
DB_URL=jdbc:mysql://127.0.0.1:3306/gea?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=gea_app
DB_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_FUERTE

# ----------------------------------------------------------------------------
# SEGURIDAD (JWT y CORS)
# ----------------------------------------------------------------------------
# Mínimo 32 caracteres, aleatorio y único. Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

CORS_ALLOWED_ORIGINS=https://gea.tudominio.edu.co
FRONTEND_URL=https://gea.tudominio.edu.co

# true en producción (requiere HTTPS real vía Nginx). Nunca en true si el
# sitio se sirve por HTTP plano.
COOKIE_SECURE=true

# Nginx (instalado nativo, ver deploy/nginx-gea.conf en GEA_FRONT) es el
# único proxy delante del backend en este servidor — mantener en true para
# que el rate-limiter cuente por IP real del cliente y no por localhost.
RATE_LIMIT_TRUST_PROXY=true

# ----------------------------------------------------------------------------
# MICROSOFT OAUTH — login institucional de la app móvil
# ----------------------------------------------------------------------------
# Valores del registro "GeaApp" en Azure (Entra ID > App registrations).
# TENANT_ID y CLIENT_ID no son secretos; CLIENT_SECRET sí — este archivo
# vive en /etc/gea/backend.env con permisos 600, nunca se sube a git.
# Vacío = login Microsoft deshabilitado (el backend arranca igual).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=CAMBIAR_POR_EL_SECRET_REAL
MICROSOFT_REDIRECT_URI=https://com.gea.app/oauth2redirect

# ----------------------------------------------------------------------------
# CORREO (SMTP)
# ----------------------------------------------------------------------------
SMTP_USER=gea.notificaciones@unilibrecucuta.edu.co
# Contraseña de aplicación de Gmail/Workspace (no la contraseña normal de la
# cuenta). Cuenta de Google > Seguridad > Verificación en dos pasos >
# Contraseñas de aplicaciones.
SMTP_PASS=CAMBIAR_POR_LA_CONTRASENA_DE_APLICACION_REAL

# Correos separados por coma que reciben aviso de cada solicitud nueva
# (y se suman a los de aprobación/rechazo/publicación) — buzones de gestión.
UNIVERSITY_RECIPIENTS=

# Correos separados por coma que reciben aviso cuando algo se PUBLICA —
# lista masiva, se envían en BCC. Distinta de UNIVERSITY_RECIPIENTS.
PUBLISHED_RECIPIENTS=

# ----------------------------------------------------------------------------
# RENDIMIENTO — ajustar según la RAM real del servidor (ver tabla de tuning
# en docs/superpowers/plans/2026-07-01-plan-migracion-nube-servidor-unico.md).
# Coordinar con MemoryMax en gea-backend.service (debe quedar por encima del
# -Xmx de aquí).
# ----------------------------------------------------------------------------
JAVA_OPTS=-Xms1g -Xmx2560m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError
